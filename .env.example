# Node Environment
NODE_ENV=
# Run webhook listener locally using the command below:
# stripe listen --forward-to localhost:3000/api/webhook

# Spin & Win wheel
# Long random string used to sign the spin cookie and prize tokens (e.g. openssl rand -hex 32)
WHEEL_SECRET=
# Largest product price (USD) that can appear on the wheel. Default 50.
WHEEL_MAX_PRIZE_PRICE=

# Seed script: real product photos (https://pixabay.com/api/docs/ or https://unsplash.com/developers)
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
# Optional: "pixabay" or "unsplash" (defaults to Pixabay when both keys are set)
PHOTO_PROVIDER=
